#!/usr/bin/expect -f
set timeout 1
set runtime_dir "/tmp/j3-testbench"
set command_file "$runtime_dir/command"
set session_log "$runtime_dir/session.log"
set driver_binary [file join [file dirname [file normalize [info script]]] motor_test]
if {![file executable $driver_binary]} {
    puts stderr "driver binary is not executable: $driver_binary"
    exit 2
}

file mkdir $runtime_dir
file delete -force $command_file
cd $runtime_dir
log_file -a $session_log
spawn -noecho $driver_binary
set pid_file [open "$runtime_dir/session.pid" w]
puts $pid_file [pid]
close $pid_file

while {1} {
    expect {
        -re {\[Command\] >} {}
        timeout {}
        eof {
            set result [wait]
            file delete -force "$runtime_dir/session.pid"
            exit [lindex $result 3]
        }
    }
    if {[file exists $command_file]} {
        set input [open $command_file r]
        set command [string trim [read $input]]
        close $input
        file delete -force $command_file
        if {$command ne ""} {
            send -- "$command\r"
        }
    }
}
