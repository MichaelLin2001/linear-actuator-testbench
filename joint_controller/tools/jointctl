from pathlib import Path


import select

import signal

import socket

import subprocess

import sys

import threading

import time

import uuid


SOCKET = '/tmp/j3-testbench/controller.sock'


def request(op, args=None, sock=SOCKET):

    payload = dict(version=1, request_id=str(uuid.uuid4()), op=op)

    payload.update(args or {})

    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:

        connection.settimeout(40)

        connection.connect(sock)

        connection.sendall((json.dumps(payload, allow_nan=False) + '\n').encode())

        connection.shutdown(socket.SHUT_WR)

        data = bytearray()

        while True:

            chunk = connection.recv(4096)

            if not chunk:

                break

            data.extend(chunk)

            if len(data) > 65536:

                raise ValueError('oversized controller response')

    return json.loads(data)


def urgent(command, sock=SOCKET):

    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as connection:

        connection.sendto(command.encode(), sock + '.urgent')


SCHEMA = {

    'experiment': ('direction', 'mode', 'position_mode', 'max_current_raw', 'extend_position_sign'),

    'staircase': ('levels', 'transition_s', 'settle_s', 'record_s'),

    'linear': ('rise_s', 'peak_hold_s', 'fall_s'),

    'preload': ('speed_mm_s', 'contact_force_n', 'contact_confirm_s', 'max_travel_mm', 'timeout_s'),

    'unload': ('current_slew_raw_s', 'retract_distance_mm', 'retract_speed_mm_s'),

    'limits': ('current_raw', 'force_n', 'position_min_mm', 'position_max_mm', 'velocity_mm_s',

               'contact_displacement_mm', 'force_timeout_ms', 'experiment_timeout_s', 'heartbeat_timeout_s'),

    'sensor': ('device', 'baud'),

    'output': ('directory',),

}


def load_config(path):

    try:

        import yaml

    except ImportError as error:

        raise RuntimeError('install PyYAML: python3 -m pip install PyYAML') from error

    class UniqueLoader(yaml.SafeLoader):

        pass

    def unique_mapping(loader, node, deep=False):

        result = {}

        for key_node, value_node in node.value:

            key = loader.construct_object(key_node, deep=deep)

            if not isinstance(key, str) or key in result:

                raise ValueError('duplicate or non-string YAML key: ' + str(key))

            result[key] = loader.construct_object(value_node, deep=deep)

        return result

    UniqueLoader.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG, unique_mapping)

    path = Path(path).resolve()

    with path.open(encoding='utf-8') as stream:

        try:
            config = yaml.load(stream, Loader=UniqueLoader)
        except yaml.YAMLError as error:
            raise ValueError('invalid or unsafe YAML: '+str(error)) from error

    if not isinstance(config, dict) or set(config) != set(SCHEMA):

        raise ValueError('YAML groups must be exactly: ' + ', '.join(SCHEMA))

    if isinstance(config.get('experiment'), dict):
        config['experiment'].setdefault('position_mode', 'relative')

    for group, keys in SCHEMA.items():

        values = config[group]

        if not isinstance(values, dict) or set(values) != set(keys):

            raise ValueError(group + ' keys must be exactly: ' + ', '.join(keys))

    for group in SCHEMA:

        for key, value in config[group].items():

            if key in ('direction', 'mode', 'position_mode', 'device', 'directory'):

                if not isinstance(value, str) or not value.strip() or any(ord(ch) < 32 for ch in value):

                    raise ValueError(group + '.' + key + ' must be a nonempty string')

                continue

            if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):

                raise ValueError(group + '.' + key + ' must be a finite number; fill every null safety value')

            signed = key in ('position_min_mm', 'position_max_mm', 'extend_position_sign')

            zero_allowed = key == 'settle_s'

            if not signed and (value < 0 if zero_allowed else value <= 0):

                raise ValueError(group + '.' + key + ' is out of range')

    e, s, l = config['experiment'], config['staircase'], config['limits']

    if e['position_mode'] not in ('relative', 'absolute'):
        raise ValueError('position_mode: relative/absolute')

    if e['direction'] not in ('extend', 'retract') or e['mode'] not in ('staircase', 'linear'):

        raise ValueError('direction: extend/retract; mode: staircase/linear')

    if e['extend_position_sign'] not in (-1, 1):

        raise ValueError('extend_position_sign must be verified as +1 or -1')

    if type(s['levels']) is not int or not 1 <= s['levels'] <= 1000:

        raise ValueError('levels must be an integer in 1..1000')

    if not (float(e['max_current_raw']).is_integer() and float(l['current_raw']).is_integer()) or l['current_raw'] > 32767:
        raise ValueError('raw peak and limit must be integers in 1..32767')

    if e['max_current_raw'] > l['current_raw'] or l['position_min_mm'] >= l['position_max_mm']:

        raise ValueError('maximum current exceeds limit or position limits are inverted')

    if config['preload']['contact_force_n'] >= l['force_n']:

        raise ValueError('contact threshold must be below force limit')

    if max(config['preload']['speed_mm_s'], config['unload']['retract_speed_mm_s']) > l['velocity_mm_s']:

        raise ValueError('requested speed exceeds velocity limit')

    if l['contact_displacement_mm'] > config['preload']['max_travel_mm']:

        raise ValueError('contact displacement must not exceed search travel')

    if not 0 < l['force_timeout_ms'] <= 1000 or not 0 < l['heartbeat_timeout_s'] <= 5:

        raise ValueError('force timeout <= 1000 ms and heartbeat timeout <= 5 s required')

    if type(config['sensor']['baud']) is not int or config['sensor']['baud'] not in (115200,230400,460800,921600):

        raise ValueError('unsupported serial baud')

    device = config['sensor']['device']

    if '"' in device or '\\' in device:

        raise ValueError('serial device cannot contain quotes or backslashes')

    # Paths in YAML always resolve relative to that YAML, not the shell cwd.

    for group, key in (('sensor','device'), ('output','directory')):

        value = Path(config[group][key]).expanduser()

        config[group][key] = str((path.parent / value).resolve() if not value.is_absolute() else value.resolve())

    return config


def controller_config(c):

    e, s, lin, p, u, lim = (c[k] for k in ('experiment','staircase','linear','preload','unload','limits'))

    sign = e['extend_position_sign'] * (1 if e['direction']=='extend' else -1)

    return dict(direction=sign, mode=e['mode'], position_mode=e.get('position_mode','relative'), max_current_raw=e['max_current_raw'], **s, **lin,

        preload_speed=p['speed_mm_s']*.001, contact_force_n=p['contact_force_n'], contact_confirm_s=p['contact_confirm_s'],

        max_travel=p['max_travel_mm']*.001, preload_timeout_s=p['timeout_s'], unload_slew_raw_s=u['current_slew_raw_s'],

        retract_distance=u['retract_distance_mm']*.001, retract_speed=u['retract_speed_mm_s']*.001,

        current_limit_raw=lim['current_raw'], force_limit_n=lim['force_n'], position_min=lim['position_min_mm']*.001,

        position_max=lim['position_max_mm']*.001, velocity_limit=lim['velocity_mm_s']*.001,

        contact_displacement=lim['contact_displacement_mm']*.001, force_timeout_s=lim['force_timeout_ms']*.001,

        experiment_timeout_s=lim['experiment_timeout_s'], heartbeat_timeout_s=lim['heartbeat_timeout_s'])


def preview(config, destination, initial=0.0):
    """Use the same C++ trajectory as the controller, before any hardware startup."""
    binary=Path(__file__).resolve().parent/'joint_controller'
    if not binary.is_file():
        raise RuntimeError('compile first and use build/bin/jointctl for offline preview')
    result=subprocess.run([str(binary),'--preview',str(Path(destination).resolve()),
        '--preview-initial-raw',str(initial)],input=json.dumps(controller_config(config),allow_nan=False)+'\n',
        text=True,capture_output=True)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or 'offline preview failed')
    return result.stdout.strip()


def stop_controller(process):
    # Wait for the owned controller to disable, drain logs and remove its sockets.
    signals = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)
    previous = {sig: signal.signal(sig, signal.SIG_IGN) for sig in signals}
    try:
        if process.poll() is None:
            try:
                process.terminate()
            except ProcessLookupError:
                pass
        try:
            code = process.wait(timeout=30)
        except subprocess.TimeoutExpired:
            raise RuntimeError(f'controller PID {process.pid} has not exited; stop is unconfirmed; inspect daemon log. Do not delete its sockets.') from None
        if code != 0:
            raise RuntimeError(f'controller exited with code {code}; inspect daemon log and confirm drive state')
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)


def interrupt_terminal(signum, frame):
    raise KeyboardInterrupt


def start(config):

    if Path(SOCKET).exists() or Path(SOCKET+'.urgent').exists():

        raise RuntimeError('socket exists; do not attach to an unknown session; stop it first')

    directory=Path(config['output']['directory']);directory.mkdir(parents=True,exist_ok=True)

    stem='experiment_'+time.strftime('%Y%m%d_%H%M%S')+'_'+uuid.uuid4().hex[:8]

    csv_path=directory/(stem+'.csv')

    binary=Path(__file__).resolve().parent/'joint_controller'

    if not binary.is_file():

        raise RuntimeError('run the built build/bin/jointctl after compiling, not tools/jointctl')

    with (directory/(stem+'.daemon.log')).open('xb') as log:

        process=subprocess.Popen([str(binary),'--enable-output','--serve','--csv',str(csv_path),

            ],

            stdin=subprocess.DEVNULL,stdout=log,stderr=subprocess.STDOUT,start_new_session=True)

    try:
        for _ in range(100):

            if process.poll() is not None:

                raise RuntimeError('controller exited; inspect '+str(directory/(stem+'.daemon.log')))

            if Path(SOCKET).exists() and Path(SOCKET+'.urgent').exists():

                try:

                    response=request('status')

                    if response['ok']:

                        return process,csv_path

                except (OSError,ValueError):

                    pass

            time.sleep(.1)

        raise RuntimeError('controller startup timeout; inspect daemon log')

    except BaseException:
        stop_controller(process)
        raise


def terminal(path):

    if os.name!='posix' or not sys.stdin.isatty():

        raise RuntimeError('interactive experiments require a Linux terminal')

    import termios

    import tty

    import yaml

    config=load_config(path)

    original=termios.tcgetattr(sys.stdin)

    process,csv_path=start(config)

    beat_done=threading.Event()

    def beats():

        while not beat_done.wait(.1):

            try:urgent('H')

            except OSError:pass

    beat_thread=threading.Thread(target=beats,daemon=True)

    pool=None

    pending=None; pending_op=None; latest={}; message=''; quitting=False; shutdown_requested=False; candidate_config=None

    try:

        beat_thread.start()
        pool=concurrent.futures.ThreadPoolExecutor(max_workers=1)

        configured=request('configure',controller_config(config))

        if not configured['ok']:raise RuntimeError(configured['message'])

        tty.setcbreak(sys.stdin)

        print('c配置 p预加载 s加载 u卸载 空格/Esc急停 r复位 q退出（调零在力传终端）',flush=True)

        print('s 执行实际 CST 加载：指令/反馈为原始单位，不是 A；u 降到零后切回位置模式退离。',flush=True)

        print('正式记录从预紧开始；输出前缀: '+str(csv_path),flush=True)

        next_status=0.0
        next_display=0.0

        while process.poll() is None:

            if pending and pending.done():

                response=pending.result();pending=None;latest=response
                if pending_op!='status':message=pending_op+': '+response.get('message','')
                pending_op=None
                if shutdown_requested and response.get('ok'):
                    break
                shutdown_requested=False

                if candidate_config is not None:

                    if response.get('ok'):config=candidate_config

                    candidate_config=None

            if quitting and not pending:

                if latest.get('stage') in ('READY','PRELOAD','RISE','SETTLE','RECORD','PEAK','FALL'):
                    pending_op='unload';pending=pool.submit(request,pending_op)

                elif latest.get('stage') in ('COMPLETE','IDLE') or latest.get('driver_disabled_confirmed'):

                    pending_op='shutdown';pending=pool.submit(request,pending_op);quitting=False;shutdown_requested=True;message='退出中'

                elif latest.get('state')=='FAULT':

                    quitting=False;message='故障停止未确认，请按急停并检查驱动；不能假装已退出'

            ready,_,_=select.select([sys.stdin],[],[],.05)

            if ready:

                key=sys.stdin.read(1)

                if not key or key in (' ','\x1b','\x03'):

                    urgent('E');message='急停已请求，等待驱动确认；不会自动退回'

                elif key=='q':

                    quitting=True

                elif not pending and key=='c':

                    if latest.get('state')!='IDLE':message='只允许失能后的IDLE重读；先卸载、停止、复位'

                    else:

                        candidate=load_config(path)

                        if candidate['sensor']!=config['sensor'] or candidate['output']!=config['output']:

                            message='设备或输出位置改变，需要退出后重启'

                        else:

                            candidate_config=candidate

                            pending_op='configure';pending=pool.submit(request,pending_op,controller_config(candidate))

                            message='正在重读 '+json.dumps(candidate['experiment'],ensure_ascii=False)

                elif not pending and key in ('p','s','u','r'):

                    pending_op={'p':'preload','s':'experiment-start','u':'unload','r':'reset'}[key]
                    pending=pool.submit(request,pending_op)

            if not pending and time.monotonic()>=next_status:

                pending_op='status';pending=pool.submit(request,pending_op);next_status=time.monotonic()+.5

            if latest and time.monotonic()>=next_display:

                next_display=time.monotonic()+.5

                line=(f"{latest.get('state')} {latest.get('stage')} fault={latest.get('fault')} "

                    f"x={latest.get('position_mm',0):.3f}mm v={latest.get('velocity_mm_s',0):.3f}mm/s "


                    f"Iraw6077={latest.get('current_raw_6077',0):.0f}raw Icmd={latest.get('commanded_current_raw',0):.0f}raw level={latest.get('level',0)} "


                    f"recording={latest.get('recording')} CSV={latest.get('csv_path','')} disabled={latest.get('driver_disabled_confirmed')} | {message}")

                print('\r\x1b[2K'+line,end='',flush=True)

    finally:

        beat_done.set()
        try:
            try:
                termios.tcsetattr(sys.stdin,termios.TCSADRAIN,original)
            except (OSError, termios.error):
                pass  # The terminal may already be closed (SIGHUP).
            if process.poll() is None:
                try:print('\n正在停止 controller、保存记录并清理会话…', flush=True)
                except OSError:pass
            stop_controller(process)
        finally:
            if beat_thread.ident is not None:
                beat_thread.join(timeout=1)
            if pool is not None:
                pool.shutdown(wait=True,cancel_futures=True)

    print('controller exited; inspect summary and daemon log')


def main():

    parser=argparse.ArgumentParser(description=__doc__)

    sub=parser.add_subparsers(dest='op',required=True)

    exp=sub.add_parser('experiment');exp.add_argument('--config',required=True)

    options=exp.add_mutually_exclusive_group();options.add_argument('--check-config',action='store_true');options.add_argument('--preview',metavar='CSV')

    exp.add_argument('--preview-initial-raw',type=float,default=0)

    for op in ('status','force','force-zero','preload','unload','reset','disable','shutdown','estop'):

        sub.add_parser(op)

    args=parser.parse_args()

    try:

        if args.op=='experiment':

            if args.check_config:print(json.dumps(controller_config(load_config(args.config)),indent=2,allow_nan=False))

            elif args.preview:print(preview(load_config(args.config),args.preview,args.preview_initial_raw))

            else:
                handlers={sig:signal.signal(sig,interrupt_terminal) for sig in (signal.SIGTERM,signal.SIGHUP)}
                try:terminal(args.config)
                finally:
                    for sig,handler in handlers.items():signal.signal(sig,handler)

            return 0

        if args.op=='estop':urgent('E');print('急停已请求；用 status 检查驱动确认');return 0

        response=request(args.op);print(json.dumps(response,indent=2,ensure_ascii=False));return 0 if response['ok'] else 2

    except KeyboardInterrupt:

        print('终端已中断；controller 清理完成。',file=sys.stderr);return 130

    except (OSError,ValueError,RuntimeError) as error:

        print(str(error),file=sys.stderr);return 2


if __name__=='__main__':

    sys.exit(main())
